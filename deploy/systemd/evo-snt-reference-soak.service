[Unit]
Description=EVO.SNT offline reference soak
Documentation=file:/opt/evo-snt/M4_SOAK_TESTS.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/evo-snt/reference-soak.env
ConditionPathExists=/etc/evo-snt/reference-soak.json
ConditionPathExists=/etc/evo-snt/reference-soak.token

[Service]
Type=oneshot
User=evo-snt
Group=evo-snt
WorkingDirectory=/opt/evo-snt
EnvironmentFile=/etc/evo-snt/reference-soak.env
Environment=EVO_SNT_HOME=/opt/evo-snt
Environment=EVO_SNT_CONFIG=/etc/evo-snt/reference-soak.json
Environment=EVO_SNT_EVIDENCE_ROOT=/var/lib/evo-snt-reference-soak/private
Environment=EVO_SNT_PUBLIC_ROOT=/var/lib/evo-snt-reference-soak/public
LoadCredential=api-token:/etc/evo-snt/reference-soak.token
StateDirectory=evo-snt-reference-soak
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/evo-snt/scripts/reference-soak-local.sh
TimeoutStartSec=infinity

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
